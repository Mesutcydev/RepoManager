    "GitHub sign-in is unavailable in this build. Update Repo Manager, or use a fine-grained token below.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sign-in is unavailable in this build. Update Repo Manager, or use a fine-grained token below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GitHub-Anmeldung ist in dieser Version nicht verfügbar. Aktualisiere Repo Manager oder nutze unten ein fein abgestuftes Token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de GitHub no está disponible en esta versión. Actualiza Repo Manager o usa abajo un token de acceso específico."
