    "Use Act mode in a chat to stage edits here before publication.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Act mode in a chat to stage edits here before publication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Ausführungsmodus in einem Chat, um hier Änderungen vor der Veröffentlichung vorzumerken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el modo Actuar en un chat para preparar cambios aquí antes de publicarlos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم وضع التنفيذ في محادثة لتجهيز تعديلات هنا قبل النشر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayımlamadan önce düzenlemeleri burada hazırlamak için sohbette Uygula modunu kullan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開前にここで変更をステージするには、チャットの実行モードを使用してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाशन से पहले यहाँ बदलाव स्टेज करने के लिए चैट में कार्रवाई मोड इस्तेमाल करें।"
          }
        }
      }
    },
    "Use Act mode to stage edits.": {
