          }
        }
      }
    },
    "The App Store returned an unknown purchase state. Try Restore Purchases.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
