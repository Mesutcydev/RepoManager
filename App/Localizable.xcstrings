            "value": "استخدام رمز بدلًا من ذلك"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine belirteç kullan"
          }
        },
        "ja": {
          "stringUnit": {
