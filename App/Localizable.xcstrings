    "Repo Manager adapts MIT-licensed OnDeviceMax UI components by Mesut and iOS Local LLM contributors. Swift-Sodium 0.11.0 is ISC-licensed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager adapts MIT-licensed OnDeviceMax UI components by Mesut and iOS Local LLM contributors. Swift-Sodium 0.11.0 is ISC-licensed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager nutzt angepasste MIT-lizenzierte OnDeviceMax-UI-Komponenten von Mesut und iOS Local LLM-Mitwirkenden. Swift-Sodium 0.11.0 steht unter der ISC-Lizenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager adapta componentes de OnDeviceMax de Mesut y colaboradores de iOS Local LLM con licencia MIT. Swift-Sodium 0.11.0 tiene licencia ISC."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدّل Repo Manager مكونات واجهة OnDeviceMax المرخصة MIT من Mesut ومساهمي iOS Local LLM. Swift-Sodium 0.11.0 مرخص ISC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager, Mesut ve iOS Local LLM katkıcılarının MIT lisanslı OnDeviceMax arayüz bileşenlerini uyarlar. Swift-Sodium 0.11.0, ISC lisanslıdır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo ManagerはMesutとiOS Local LLMの貢献者によるMITライセンスのOnDeviceMax UIを改変して使用しています。Swift-Sodium 0.11.0はISCライセンスです。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager, Mesut और iOS Local LLM योगदानकर्ताओं के MIT-लाइसेंस वाले OnDeviceMax UI घटक अनुकूलित करता है। Swift-Sodium 0.11.0 का ISC लाइसेंस है।"
          }
        }
      }
    },
