    "Enter this credential directly in the client, or securely pair on the same trusted network. It is never exported or copied. Closing this sheet removes it from the display.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this credential directly in the client, or securely pair on the same trusted network. It is never exported or copied. Closing this sheet removes it from the display."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib diese Zugangsdaten direkt im Client ein oder kopple sicher im selben vertrauenswürdigen Netzwerk. Sie werden nie exportiert oder kopiert. Beim Schließen verschwindet die Anzeige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce esta credencial directamente en el cliente o vincúlalo de forma segura en la misma red de confianza. Nunca se exporta ni copia. Al cerrar, desaparece de la pantalla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل بيانات الاعتماد مباشرة في العميل، أو اربط بأمان على الشبكة الموثوقة نفسها. لا تُصدّر أو تُنسخ. إغلاق هذه الصفحة يخفيها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimlik bilgisini doğrudan istemciye gir veya aynı güvenilir ağda güvenle eşleştir. Asla dışa aktarılmaz veya kopyalanmaz. Sayfa kapanınca ekrandan kaldırılır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報をクライアントに直接入力するか、同じ信頼できるネットワークで安全に接続してください。書き出しやコピーはされません。この画面を閉じると表示から消えます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्रेडेंशियल सीधे क्लाइंट में डालें या उसी भरोसेमंद नेटवर्क पर सुरक्षित रूप से जोड़ें। इसे कभी निर्यात या कॉपी नहीं किया जाता। यह शीट बंद होने पर यह स्क्रीन से हट जाता है।"
          }
        }
      }
    },
