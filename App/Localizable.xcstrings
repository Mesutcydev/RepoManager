    "Select a repository and branch for this chat. If you have no chat yet, Repo Manager creates one for you. Staged edits stay on this device until you review them.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a repository and branch for this chat. If you have no chat yet, Repo Manager creates one for you. Staged edits stay on this device until you review them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Repository und einen Branch für diesen Chat. Wenn noch kein Chat besteht, erstellt Repo Manager einen. Vorgemerkte Änderungen bleiben bis zur Prüfung auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige repositorio y rama para este chat. Si aún no tienes chat, Repo Manager crea uno. Los cambios preparados quedan en el dispositivo hasta que los revises."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستودعًا وفرعًا لهذه المحادثة. ينشئ Repo Manager محادثة إن لم توجد. تبقى التعديلات المجهّزة على الجهاز حتى تراجعها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet için depo ve dal seç. Henüz sohbetin yoksa Repo Manager bir tane oluşturur. Hazırlanan düzenlemeler inceleyene kadar bu aygıtta kalır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのリポジトリとブランチを選択してください。チャットがない場合は新しく作成します。ステージした変更はレビューするまでデバイス内に留まります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चैट के लिए रिपॉज़िटरी और ब्रांच चुनें। चैट न होने पर Repo Manager एक बना देगा। समीक्षा तक स्टेज किए बदलाव इसी डिवाइस पर रहेंगे।"
          }
        }
      }
    },
    "Select a repository first.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a repository first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst ein Repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige primero un repositorio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستودعًا أولًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir depo seç."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にリポジトリを選択してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले रिपॉज़िटरी चुनें।"
          }
        }
      }
    },
    "Select a repository in a chat to attach a release asset. Files stay encrypted on this device; maximum size is 50 MiB.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a repository in a chat to attach a release asset. Files stay encrypted on this device; maximum size is 50 MiB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in einem Chat ein Repository, um eine Release-Datei anzuhängen. Dateien bleiben auf diesem Gerät verschlüsselt; maximal 50 MiB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un repositorio en un chat para adjuntar un recurso de versión. Los archivos quedan cifrados en el dispositivo; máximo 50 MiB."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستودعًا في محادثة لإرفاق أصل إصدار. تبقى الملفات مشفرة على الجهاز؛ الحد الأقصى 50 MiB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm varlığı eklemek için sohbette depo seç. Dosyalar bu aygıtta şifreli kalır; en fazla 50 MiB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリースアセットを添付するには、チャットでリポジトリを選択してください。ファイルはこのデバイスで暗号化されます。最大50 MiBです。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ एसेट जोड़ने के लिए चैट में रिपॉज़िटरी चुनें। फ़ाइलें इसी डिवाइस पर एन्क्रिप्टेड रहती हैं; अधिकतम आकार 50 MiB।"
          }
        }
      }
    },
