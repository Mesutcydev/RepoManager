          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten 30 Ergebnisse. Nutze Werkzeuge, um GitHub zu durchsuchen oder einen bestimmten Eintrag zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros 30 resultados. Usa Herramientas para buscar en GitHub o abrir un elemento concreto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أول 30 نتيجة. استخدم الأدوات للبحث في GitHub أو فتح عنصر محدد."
          }
        },
        "tr": {
