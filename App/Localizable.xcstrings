          }
        }
      }
    },
    "The account was removed locally. Remote sign-out could not be confirmed; disconnect Repo Manager in ChatGPT settings.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account was removed locally. Remote sign-out could not be confirmed; disconnect Repo Manager in ChatGPT settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto wurde lokal entfernt. Die entfernte Abmeldung konnte nicht bestätigt werden; trenne Repo Manager in den ChatGPT-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó la cuenta localmente. No se confirmó el cierre remoto; desconecta Repo Manager en los ajustes de ChatGPT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل الحساب محليًا. تعذر تأكيد الخروج البعيد؛ افصل Repo Manager في إعدادات ChatGPT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yerel olarak kaldırıldı. Uzak çıkış doğrulanamadı; ChatGPT ayarlarında Repo Manager bağlantısını kes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントをローカルで削除しました。リモートのサインアウトを確認できなかったため、ChatGPTの設定でRepo Managerを接続解除してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता स्थानीय रूप से हटाया गया। रिमोट साइन-आउट की पुष्टि नहीं हुई; ChatGPT सेटिंग में Repo Manager डिस्कनेक्ट करें।"
          }
        }
      }
    },
    "The first 2,000 repositories are loaded.": {
