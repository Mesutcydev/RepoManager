    "App budgets remain capped at 8,192 input and 4,096 output tokens; smaller model limits take priority.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App budgets remain capped at 8,192 input and 4,096 output tokens; smaller model limits take priority."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App begrenzt Eingaben auf 8.192 und Ausgaben auf 4.096 Tokens; kleinere Modelllimits haben Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app limita la entrada a 8.192 tokens y la salida a 4.096; prevalecen los límites menores del modelo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدود التطبيق 8,192 رمز إدخال و4,096 رمز إخراج؛ تُقدّم حدود النموذج الأصغر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bütçesi 8.192 giriş ve 4.096 çıkış tokeniyle sınırlıdır; daha düşük model sınırları önceliklidir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの上限は入力8,192、出力4,096トークンです。モデルの上限が小さい場合はそちらを優先します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की सीमा 8,192 इनपुट और 4,096 आउटपुट टोकन है; मॉडल की छोटी सीमा को प्राथमिकता मिलती है।"
          }
        }
      }
    },
