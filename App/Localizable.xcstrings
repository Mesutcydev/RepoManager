    "Only the selected repository is granted. Repository creation, forking, and secret entry remain in the native app.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected repository is granted. Repository creation, forking, and secret entry remain in the native app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das gewählte Repository wird freigegeben. Erstellen, Forken und die Eingabe von Geheimnissen bleiben in der nativen App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se autoriza el repositorio seleccionado. Crear y bifurcar repositorios e introducir secretos queda en la app nativa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُمنح الوصول للمستودع المحدد فقط. إنشاء المستودعات وتفريعها وإدخال الأسرار يبقى في التطبيق الأصلي."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili depoya izin verilir. Depo oluşturma, çatallama ve sır girişi yerel uygulamada kalır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したリポジトリのみ許可します。リポジトリの作成、フォーク、シークレットの入力はネイティブアプリで行います。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल चुनी रिपॉज़िटरी की अनुमति है। रिपॉज़िटरी बनाना, फ़ोर्क करना और सीक्रेट डालना नेटिव ऐप में रहता है।"
          }
        }
      }
    },
    "Only this explicit text is used as persistent context memory.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this explicit text is used as persistent context memory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieser ausdrücklich eingegebene Text dient als dauerhafter Kontext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este texto explícito se usa como memoria de contexto persistente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم هذا النص الصريح فقط كذاكرة سياق دائمة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı bağlam belleği olarak yalnızca bu açık metin kullanılır."
