    "Approval applies only to this snapshot. Account, branch, target or draft changes require a fresh review.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval applies only to this snapshot. Account, branch, target or draft changes require a fresh review."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Genehmigung gilt nur für diesen Stand. Änderungen an Konto, Branch, Ziel oder Entwurf erfordern eine neue Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación solo se aplica a esta instantánea. Los cambios de cuenta, rama, destino o borrador requieren otra revisión."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق الموافقة على هذه اللقطة فقط. تغيير الحساب أو الفرع أو الهدف أو المسودة يتطلب مراجعة جديدة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay yalnızca bu anlık görüntü için geçerlidir. Hesap, dal, hedef veya taslak değişirse yeni inceleme gerekir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認はこのスナップショットにのみ適用されます。アカウント、ブランチ、対象、下書きが変わると再レビューが必要です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
