    "The App Store purchase could not be verified. Pro has not been unlocked.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store purchase could not be verified. Pro has not been unlocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App-Store-Kauf konnte nicht verifiziert werden. Pro wurde nicht freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra del App Store. Pro no se ha desbloqueado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من شراء App Store. لم يُفتح Pro."
          }
        },
        "tr": {
