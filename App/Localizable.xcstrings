    "Local erasure preserves the optional shared history key and does not delete your encrypted iCloud history.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local erasure preserves the optional shared history key and does not delete your encrypted iCloud history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Löschen behält den optionalen gemeinsamen Verlaufsschlüssel bei und löscht deinen verschlüsselten iCloud-Verlauf nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrado local conserva la clave opcional del historial compartido y no elimina el historial cifrado de iCloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ المسح المحلي على مفتاح السجل المشترك الاختياري ولا يحذف سجل iCloud المشفر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel silme, isteğe bağlı ortak geçmiş anahtarını korur ve şifreli iCloud geçmişini silmez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの消去では任意の共有履歴キーは保持され、iCloudの暗号化された履歴も削除されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय मिटाने से वैकल्पिक साझा इतिहास कुंजी सुरक्षित रहती है और एन्क्रिप्ट किया गया iCloud इतिहास नहीं मिटता।"
          }
        }
      }
    },
