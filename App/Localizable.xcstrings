    "Verify the fingerprint in person and trust the public certificate on the client. It validates this configured hostname or IP. Never disable certificate verification.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the fingerprint in person and trust the public certificate on the client. It validates this configured hostname or IP. Never disable certificate verification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Fingerabdruck persönlich und vertraue dem öffentlichen Zertifikat auf dem Client. Es bestätigt den konfigurierten Hostnamen oder die IP. Deaktiviere niemals die Zertifikatprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la huella en persona y confía en el certificado público en el cliente. Valida el host o la IP configurados. Nunca desactives la verificación de certificados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من البصمة شخصيًا وثق بالشهادة العامة على العميل. تتحقق من اسم المضيف أو IP المُعدّ. لا تعطل التحقق من الشهادات أبدًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izini yüz yüze doğrula ve istemcide genel sertifikaya güven. Yapılandırılan ana makine adı veya IP’yi doğrular. Sertifika doğrulamayı asla kapatma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィンガープリントを直接確認して、クライアントで公開証明書を信頼してください。設定したホスト名またはIPを検証します。証明書検証を無効にしないでください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िंगरप्रिंट स्वयं जाँचें और क्लाइंट पर सार्वजनिक प्रमाणपत्र पर भरोसा सेट करें। यह तय होस्टनाम या IP सत्यापित करता है। प्रमाणपत्र सत्यापन कभी बंद न करें।"
          }
        }
      }
    },
