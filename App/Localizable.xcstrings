    "Every change shows its before/after state. Permission, protection, visibility, secret, deployment, transfer and deletion changes additionally require native authentication.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every change shows its before/after state. Permission, protection, visibility, secret, deployment, transfer and deletion changes additionally require native authentication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung zeigt den Vorher-/Nachher-Zustand. Änderungen an Berechtigungen, Schutz, Sichtbarkeit, Geheimnissen, Deployments, Übertragungen und Löschungen erfordern zusätzlich native Authentifizierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio muestra el antes y el después. Los cambios de permisos, protección, visibilidad, secretos, despliegues, transferencias y borrados requieren además autenticación nativa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كل تغيير حالته قبل وبعد. تغييرات الصلاحيات والحماية والظهور والأسرار والنشر والنقل والحذف تتطلب أيضًا مصادقة أصلية."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değişiklik önceki ve sonraki durumu gösterir. İzin, koruma, görünürlük, sır, dağıtım, aktarım ve silme değişiklikleri ayrıca yerel kimlik doğrulama gerektirir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各変更の前後の状態を表示します。権限、保護、公開範囲、シークレット、デプロイ、移譲、削除の変更には、さらにデバイスでの認証が必要です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बदलाव पहले और बाद की स्थिति दिखाता है। अनुमति, सुरक्षा, दृश्यता, सीक्रेट, डिप्लॉयमेंट, स्थानांतरण और मिटाने के बदलावों के लिए अतिरिक्त नेटिव प्रमाणीकरण चाहिए।"
          }
        }
      }
    },
    "Every change,\nin your hands.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every change,\nin your hands."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung\nin deiner Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio,\nen tus manos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تغيير،\nبين يديك."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değişiklik\nsenin elinde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての変更を、\nその手で。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बदलाव,\nआपके हाथों में।"
          }
        }
      }
    },
    "Every remote change needs your review.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every remote change needs your review."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede entfernte Änderung braucht deine Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio remoto necesita tu revisión."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تغيير بعيد يحتاج لمراجعتك."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uzak değişiklik incelemeni gerektirir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートへの変更には必ずレビューが必要です。"
          }
        },
        "hi": {
