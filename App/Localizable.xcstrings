    "GitHub did not supply a text diff for this file. Binary or oversized content requires separate inspection.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub did not supply a text diff for this file. Binary or oversized content requires separate inspection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat keinen Textdiff für diese Datei geliefert. Binäre oder zu große Inhalte müssen separat geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no proporcionó un diff de texto para este archivo. El contenido binario o demasiado grande requiere inspección aparte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوفر GitHub فرقًا نصيًا لهذا الملف. يتطلب المحتوى الثنائي أو الكبير فحصًا منفصلًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub bu dosya için metin farkı sağlamadı. İkili veya büyük içerik ayrıca incelenmeli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルのテキスト差分はGitHubから提供されませんでした。バイナリや大きすぎる内容は別途確認が必要です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने इस फ़ाइल का टेक्स्ट अंतर नहीं दिया। बाइनरी या बड़ी सामग्री अलग से जाँचें।"
          }
        }
      }
    },
