    "Signed out locally. Remote sign-out could not be confirmed; disconnect Repo Manager in ChatGPT settings.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out locally. Remote sign-out could not be confirmed; disconnect Repo Manager in ChatGPT settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal abgemeldet. Die entfernte Abmeldung konnte nicht bestätigt werden; trenne Repo Manager in den ChatGPT-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión local cerrada. No se pudo confirmar el cierre remoto; desconecta Repo Manager en los ajustes de ChatGPT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الخروج محليًا. تعذر تأكيد الخروج البعيد؛ افصل Repo Manager في إعدادات ChatGPT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel çıkış yapıldı. Uzak çıkış doğrulanamadı; ChatGPT ayarlarında Repo Manager bağlantısını kes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルでサインアウトしました。リモートのサインアウトを確認できなかったため、ChatGPTの設定でRepo Managerを接続解除してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय साइन-आउट हुआ। रिमोट साइन-आउट की पुष्टि नहीं हुई; ChatGPT सेटिंग में Repo Manager डिस्कनेक्ट करें।"
          }
        }
      }
    },
    "Signing in connects your account. Install the GitHub App to choose which repositories it can use.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in connects your account. Install the GitHub App to choose which repositories it can use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung verbindet dein Konto. Installiere die GitHub App, um die nutzbaren Repositories zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión conecta tu cuenta. Instala la GitHub App para elegir los repositorios que puede usar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل الدخول حسابك. ثبّت تطبيق GitHub لاختيار المستودعات التي يمكنه استخدامها."
          }
        },
        "tr": {
          "stringUnit": {
