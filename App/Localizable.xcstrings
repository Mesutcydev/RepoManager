    "Limit the token to the repositories and permissions you need. Credentials stay in this device’s Keychain.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit the token to the repositories and permissions you need. Credentials stay in this device’s Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschränke das Token auf die benötigten Repositories und Berechtigungen. Zugangsdaten bleiben im Schlüsselbund dieses Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el token a los repositorios y permisos necesarios. Las credenciales permanecen en el Llavero de este dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصر الرمز في المستودعات والصلاحيات المطلوبة. تبقى بيانات الاعتماد في سلسلة مفاتيح الجهاز."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirteci gereken depolar ve izinlerle sınırla. Kimlik bilgileri bu aygıtın Anahtar Zinciri’nde kalır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
