    "Apple Intelligence": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "shouldTranslate": false
    },
    "Apple manages the system models. No API credential or model download is needed. Private Cloud Compute requires OS 27 and this app's signed entitlement; the on-device option uses the installed Apple system model.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple manages the system models. No API credential or model download is needed. Private Cloud Compute requires OS 27 and this app's signed entitlement; the on-device option uses the installed Apple system model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verwaltet die Systemmodelle. Kein API-Schlüssel oder Modelldownload nötig. Private Cloud Compute erfordert OS 27 und die signierte App-Berechtigung; die lokale Option nutzt das installierte Apple-Systemmodell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gestiona los modelos del sistema. No se necesita clave API ni descargar modelos. Private Cloud Compute requiere OS 27 y el permiso firmado de la app; la opción local usa el modelo de Apple instalado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدير Apple نماذج النظام. لا حاجة لمفتاح API أو تنزيل نموذج. يتطلب Private Cloud Compute نظام OS 27 واستحقاق التطبيق الموقّع؛ ويستخدم الخيار المحلي نموذج Apple المثبت."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem modellerini Apple yönetir. API kimlik bilgisi veya model indirmesi gerekmez. Private Cloud Compute, OS 27 ve uygulamanın imzalı yetkisini gerektirir; aygıt seçeneği yüklü Apple modelini kullanır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムモデルはAppleが管理します。API認証情報やモデルのダウンロードは不要です。Private Cloud ComputeにはOS 27と署名済みのアプリ権限が必要です。デバイス内の処理にはインストール済みのAppleモデルを使います。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम मॉडल Apple संभालता है। API क्रेडेंशियल या मॉडल डाउनलोड ज़रूरी नहीं है। Private Cloud Compute के लिए OS 27 और ऐप का हस्ताक्षरित अधिकार चाहिए; डिवाइस वाला विकल्प इंस्टॉल किया Apple मॉडल इस्तेमाल करता है।"
          }
        }
      }
    },
    "Apple's current usage limit has been reached.": {
      "extractionState": "manual",
      "generatesSymbol": false,
