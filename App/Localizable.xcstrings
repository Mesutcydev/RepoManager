    "Pair GitHub and bring the API provider you trust. You choose the repository, model, and destination for each conversation.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair GitHub and bring the API provider you trust. You choose the repository, model, and destination for each conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde GitHub und den API-Anbieter deines Vertrauens. Du wählst Repository, Modell und Ziel für jeden Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta GitHub y el proveedor de API en el que confíes. Elige repositorio, modelo y destino para cada conversación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صل GitHub وأضف مزود API الذي تثق به. اختر المستودع والنموذج والوجهة لكل محادثة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub’ı eşleştir ve güvendiğin API sağlayıcısını ekle. Her sohbetin deposunu, modelini ve hedefini sen seçersin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubと信頼するAPIプロバイダを接続。チャットごとにリポジトリ、モデル、送信先を選べます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub और अपने भरोसेमंद API प्रदाता को जोड़ें। हर बातचीत के लिए रिपॉज़िटरी, मॉडल और गंतव्य आप चुनते हैं।"
          }
        }
      }
    },
