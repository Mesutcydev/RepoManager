    "Connect a provider and begin a conversation. Add a repository when you want to inspect files or plan a change.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a provider and begin a conversation. Add a repository when you want to inspect files or plan a change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen Anbieter und beginne einen Chat. Füge ein Repository hinzu, um Dateien zu prüfen oder Änderungen zu planen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un proveedor y empieza una conversación. Añade un repositorio para examinar archivos o planificar cambios."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صل مزودًا وابدأ محادثة. أضف مستودعًا عندما تريد فحص الملفات أو التخطيط لتغيير."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sağlayıcı bağla ve sohbet başlat. Dosyaları incelemek veya değişiklik planlamak için depo ekle."
