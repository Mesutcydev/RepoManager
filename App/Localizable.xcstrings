    "Mention @path/to/file, @issue:123, @pr:123, or an attached document. Use read/search tools to retrieve bounded context on the selected repository.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mention @path/to/file, @issue:123, @pr:123, or an attached document. Use read/search tools to retrieve bounded context on the selected repository."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verweise auf @path/to/file, @issue:123, @pr:123 oder ein angehängtes Dokument. Nutze Lese-/Suchwerkzeuge für begrenzten Kontext aus dem gewählten Repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menciona @path/to/file, @issue:123, @pr:123 o un documento adjunto. Usa herramientas de lectura o búsqueda para obtener contexto limitado del repositorio seleccionado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اذكر @path/to/file أو @issue:123 أو @pr:123 أو مستندًا مرفقًا. استخدم أدوات القراءة والبحث لاسترجاع سياق محدود من المستودع المحدد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@path/to/file, @issue:123, @pr:123 veya ekli belgeyi etiketle. Seçili depodan sınırlı bağlam almak için okuma/arama araçlarını kullan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@path/to/file、@issue:123、@pr:123、添付文書を参照できます。読み取り・検索ツールで、選択したリポジトリから範囲を限定したコンテキストを取得してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@path/to/file, @issue:123, @pr:123 या जुड़े दस्तावेज़ का उल्लेख करें। चुनी रिपॉज़िटरी से सीमित संदर्भ लाने के लिए पढ़ने/खोजने वाले टूल इस्तेमाल करें।"
          }
        }
      }
    },
