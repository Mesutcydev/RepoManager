    "Open Safari also copies your code. Paste it on GitHub and approve the connection, then return to Repo Manager to finish.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari also copies your code. Paste it on GitHub and approve the connection, then return to Repo Manager to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Safari öffnen“ kopiert auch deinen Code. Füge ihn auf GitHub ein, genehmige die Verbindung und kehre zu Repo Manager zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Safari también copia tu código. Pégalo en GitHub, aprueba la conexión y vuelve a Repo Manager."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح Safari ينسخ رمزك أيضًا. الصقه على GitHub ووافق على الاتصال، ثم عد إلى Repo Manager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari’yi açmak kodunu da kopyalar. GitHub’a yapıştırıp bağlantıyı onayla, ardından Repo Manager’a dön."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Safariを開く」でコードもコピーします。GitHubに貼り付けて接続を承認し、Repo Managerに戻ってください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari खोलने से कोड भी कॉपी होता है। उसे GitHub पर पेस्ट करके कनेक्शन मंज़ूर करें, फिर Repo Manager पर लौटें।"
          }
        }
      }
    },
