    "Imported drafts require explicit repository reconnection and a new native review before publication.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported drafts require explicit repository reconnection and a new native review before publication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Entwürfe erfordern vor der Veröffentlichung eine ausdrückliche Repository-Neuverbindung und eine neue native Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores importados requieren reconectar explícitamente el repositorio y una nueva revisión nativa antes de publicarse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب المسودات المستوردة إعادة توصيل المستودع صراحةً ومراجعة أصلية جديدة قبل النشر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan taslaklar yayımlanmadan önce deponun açıkça yeniden bağlanmasını ve yeni yerel inceleme gerektirir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ下書きの公開には、リポジトリの明示的な再接続と新しいネイティブレビューが必要です。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात किए ड्राफ़्ट प्रकाशित करने से पहले रिपॉज़िटरी फिर जोड़ना और नई नेटिव समीक्षा आवश्यक है।"
          }
        }
      }
    },
