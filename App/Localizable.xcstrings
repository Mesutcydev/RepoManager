    "Sign in with Safari. After approving access, return to Repo Manager to finish connecting.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Safari. After approving access, return to Repo Manager to finish connecting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Safari an. Kehre nach der Genehmigung zu Repo Manager zurück, um die Verbindung abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Safari. Tras aprobar el acceso, vuelve a Repo Manager para terminar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الدخول عبر Safari. بعد الموافقة على الوصول، عد إلى Repo Manager لإكمال الاتصال."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ile giriş yap. Erişimi onayladıktan sonra bağlantıyı tamamlamak için Repo Manager’a dön."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariでサインインしてください。アクセスを承認したら、Repo Managerに戻って接続を完了してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari से साइन इन करें। ऐक्सेस मंज़ूर करने के बाद कनेक्शन पूरा करने के लिए Repo Manager पर लौटें।"
          }
        }
      }
    },
