    "This code has expired. Cancel and start again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired. Cancel and start again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen. Brich ab und starte erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código caducó. Cancela y empieza de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز. ألغِ وابدأ مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodun süresi doldu. İptal edip yeniden başlat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは有効期限切れです。キャンセルしてやり直してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कोड की समय सीमा समाप्त हुई। रद्द करके फिर शुरू करें।"
          }
        }
      }
    },
    "This conversation owns a staged draft. Create another chat for a different repository, or explicitly discard the draft first.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation owns a staged draft. Create another chat for a different repository, or explicitly discard the draft first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat besitzt einen vorgemerkten Entwurf. Erstelle für ein anderes Repository einen neuen Chat oder verwirf zuerst ausdrücklich den Entwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación tiene un borrador preparado. Crea otro chat para otro repositorio o descarta primero el borrador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تملك هذه المحادثة مسودة مجهّزة. أنشئ محادثة أخرى لمستودع مختلف أو تجاهل المسودة صراحةً أولًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbetin hazırlanmış taslağı var. Farklı depo için başka sohbet oluştur veya önce taslaktan açıkça vazgeç."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話にはステージ済みの下書きがあります。別のリポジトリには新しいチャットを作るか、先に下書きを明示的に破棄してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बातचीत का स्टेज किया ड्राफ़्ट है। दूसरी रिपॉज़िटरी के लिए नई चैट बनाएँ या पहले ड्राफ़्ट स्पष्ट रूप से त्यागें।"
          }
        }
      }
    },
    "This example stays here. Real approvals always identify the account, repository, branch, and complete change.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This example stays here. Real approvals always identify the account, repository, branch, and complete change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Beispiel bleibt hier. Echte Genehmigungen benennen immer Konto, Repository, Branch und die vollständige Änderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ejemplo se queda aquí. Las aprobaciones reales siempre identifican la cuenta, el repositorio, la rama y el cambio completo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى هذا المثال هنا. تحدد الموافقات الفعلية دائمًا الحساب والمستودع والفرع والتغيير الكامل."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu örnek burada kalır. Gerçek onaylarda hesap, depo, dal ve değişikliğin tamamı her zaman belirtilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この例が外部に反映されることはありません。実際の承認では、アカウント、リポジトリ、ブランチ、変更の全体が示されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उदाहरण यहीं रहता है। असली मंज़ूरियों में हमेशा खाता, रिपॉज़िटरी, ब्रांच और पूरा बदलाव पहचाना जाता है।"
          }
        }
      }
    },
