    "A write response was lost. Inspect GitHub's current state before any retry.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A write response was lost. Inspect GitHub's current state before any retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schreibantwort ging verloren. Prüfe vor jedem erneuten Versuch den aktuellen Zustand auf GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la respuesta de escritura. Revisa el estado actual de GitHub antes de reintentar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُقدت استجابة كتابة. افحص حالة GitHub الحالية قبل أي إعادة محاولة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma yanıtı kayboldu. Yeniden denemeden önce GitHub’ın güncel durumunu incele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みの応答が失われました。再試行する前にGitHubの現在の状態を確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखने का उत्तर खो गया। फिर कोशिश करने से पहले GitHub की मौजूदा स्थिति देखें।"
          }
        }
      }
    },
