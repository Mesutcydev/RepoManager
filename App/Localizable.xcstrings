    "Its messages and local draft are removed from this device. This can’t be undone.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its messages and local draft are removed from this device. This can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten und lokaler Entwurf werden von diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus mensajes y borrador local se eliminan del dispositivo. No se puede deshacer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف الرسائل والمسودة المحلية من هذا الجهاز. لا يمكن التراجع."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajları ve yerel taslağı bu aygıttan silinir. Bu işlem geri alınamaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージとローカルの下書きがこのデバイスから削除されます。取り消せません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके संदेश और स्थानीय ड्राफ़्ट इस डिवाइस से हट जाएँगे। यह वापस नहीं किया जा सकता।"
          }
        }
      }
    },
    "Its saved credential is deleted from Keychain. Conversations using it will need another model.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its saved credential is deleted from Keychain. Conversations using it will need another model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Zugangsdaten werden aus dem Schlüsselbund gelöscht. Betroffene Chats brauchen ein anderes Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su credencial guardada se elimina del Llavero. Las conversaciones que la usan necesitarán otro modelo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف بيانات الاعتماد المحفوظة من سلسلة المفاتيح. ستحتاج المحادثات التي تستخدمها لنموذج آخر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kimlik bilgisi Anahtar Zinciri’nden silinir. Bunu kullanan sohbetlerin başka modele ihtiyacı olacak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した認証情報をキーチェーンから削除します。使用中のチャットでは別のモデルが必要になります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा क्रेडेंशियल कीचेन से हटेगा। इसे इस्तेमाल कर रही बातचीत को दूसरा मॉडल चाहिए होगा।"
          }
        }
      }
    },
    "Its token is removed from this device. Running work for its repositories stops, pending reviews are cancelled, and the API server turns off. Local drafts are kept.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its token is removed from this device. Running work for its repositories stops, pending reviews are cancelled, and the API server turns off. Local drafts are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird von diesem Gerät entfernt. Laufende Arbeit an den Repositories stoppt, offene Prüfungen werden abgebrochen und der API-Server wird deaktiviert. Lokale Entwürfe bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se elimina del dispositivo. Se detiene el trabajo en sus repositorios, se cancelan las revisiones pendientes y se apaga el servidor API. Se conservan los borradores locales."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف الرمز من الجهاز. يتوقف العمل الجاري للمستودعات وتُلغى المراجعات المعلقة ويتوقف خادم API. تُحفظ المسودات المحلية."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirteci bu aygıttan kaldırılır. Depolarındaki işler durur, bekleyen incelemeler iptal edilir ve API sunucusu kapanır. Yerel taslaklar korunur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンをこのデバイスから削除します。関連リポジトリの作業は停止し、保留中のレビューはキャンセルされ、APIサーバーは停止します。ローカルの下書きは保持します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका टोकन डिवाइस से हटेगा। संबंधित रिपॉज़िटरी के काम रुकेंगे, लंबित समीक्षाएँ रद्द होंगी और API सर्वर बंद होगा। स्थानीय ड्राफ़्ट सुरक्षित रहेंगे।"
          }
        }
      }
    },
    "Keep the list and details side by side.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the list and details side by side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste und Details nebeneinander anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la lista y los detalles lado a lado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ القائمة والتفاصيل جنبًا إلى جنب."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeyi ve ayrıntıları yan yana tut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストと詳細を並べて表示します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची और विवरण साथ-साथ रखें।"
          }
        }
      }
    },
    "Language": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللغة"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा"
          }
        }
      }
    },
    "Leave the credential empty to retain it for the same endpoint. Changing the endpoint removes the saved credential.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the credential empty to retain it for the same endpoint. Changing the endpoint removes the saved credential."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Zugangsdaten leer, um sie für denselben Endpunkt zu behalten. Ein Endpunktwechsel entfernt die gespeicherten Zugangsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la credencial vacía para conservarla en el mismo endpoint. Cambiar el endpoint elimina la credencial guardada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك بيانات الاعتماد فارغة للاحتفاظ بها لنقطة النهاية نفسها. تغيير نقطة النهاية يحذف البيانات المحفوظة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uç nokta için kimlik bilgisini korumak istiyorsan boş bırak. Uç noktayı değiştirmek kayıtlı kimlik bilgisini siler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じエンドポイントの認証情報を保持するには空欄にしてください。エンドポイントを変更すると保存済みの認証情報は削除されます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी एंडपॉइंट के लिए क्रेडेंशियल रखने हेतु खाली छोड़ें। एंडपॉइंट बदलने से सहेजा क्रेडेंशियल हटता है।"
          }
        }
      }
    },
    "Let external agents use your providers and repository tools through scoped grants.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let external agents use your providers and repository tools through scoped grants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Agents dürfen deine Anbieter und Repository-Werkzeuge mit begrenzten Berechtigungen nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a agentes externos usar tus proveedores y herramientas con permisos limitados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للوكلاء الخارجيين باستخدام مزوديك وأدوات المستودع بأذونات محددة النطاق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış ajanların sağlayıcılarını ve depo araçlarını sınırlı izinlerle kullanmasına izin ver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部エージェントに範囲を限定した権限を与え、プロバイダとリポジトリツールを利用させます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी एजेंट को सीमित अनुमतियों से अपने प्रदाता और रिपॉज़िटरी टूल इस्तेमाल करने दें।"
          }
        }
      }
    },
