    "Read a file alongside the repository tree. Edits remain in this conversation until you stage them.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a file alongside the repository tree. Edits remain in this conversation until you stage them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies eine Datei neben dem Repository-Baum. Änderungen bleiben in diesem Chat, bis du sie vormerkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un archivo junto al árbol del repositorio. Los cambios quedan en la conversación hasta prepararlos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ ملفًا بجانب شجرة المستودع. تبقى التعديلات في المحادثة حتى تجهّزها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo ağacının yanında dosyayı oku. Düzenlemeler hazırlanana kadar bu sohbette kalır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリツリーの横でファイルを確認できます。変更はステージするまでこの会話内に留まります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपॉज़िटरी ट्री के साथ फ़ाइल पढ़ें। स्टेज करने तक संपादन इस बातचीत में रहते हैं।"
          }
        }
      }
    },
