    "After creating a new vault, import your encrypted backup in Settings. Reconnect providers and GitHub, then review drafts again before publishing.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After creating a new vault, import your encrypted backup in Settings. Reconnect providers and GitHub, then review drafts again before publishing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere nach dem Erstellen eines neuen Tresors dein verschlüsseltes Backup in den Einstellungen. Verbinde Anbieter und GitHub erneut und prüfe Entwürfe vor dem Veröffentlichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras crear una nueva bóveda, importa tu copia cifrada en Ajustes. Vuelve a conectar los proveedores y GitHub y revisa los borradores antes de publicarlos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إنشاء خزنة جديدة، استورد نسختك الاحتياطية المشفرة من الإعدادات. أعد توصيل المزودين وGitHub وراجع المسودات قبل النشر."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni kasa oluşturduktan sonra şifreli yedeğini Ayarlar’dan içe aktar. Sağlayıcıları ve GitHub’ı yeniden bağla, yayımlamadan önce taslakları tekrar incele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい保管庫を作成したら、設定で暗号化バックアップを読み込んでください。プロバイダとGitHubを再接続し、公開前に下書きを再確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई तिजोरी बनाने के बाद सेटिंग में एन्क्रिप्ट किया गया बैकअप आयात करें। प्रदाताओं और GitHub को फिर जोड़ें और प्रकाशित करने से पहले ड्राफ़्ट की दोबारा समीक्षा करें।"
          }
        }
      }
    },
    "Agents can access names and status only. Enter values in this native secure field.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can access names and status only. Enter values in this native secure field."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents können nur Namen und Status abrufen. Gib Werte in diesem nativen sicheren Feld ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes solo acceden a nombres y estados. Introduce valores en este campo nativo seguro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكلاء الوصول للأسماء والحالة فقط. أدخل القيم في هذا الحقل الأصلي الآمن."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar yalnızca adlara ve duruma erişebilir. Değerleri bu yerel güvenli alana gir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが取得できるのは名前と状態のみです。値はこのネイティブの保護された欄に入力してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट केवल नाम और स्थिति देख सकते हैं। मान इस नेटिव सुरक्षित फ़ील्ड में डालें।"
          }
        }
      }
    },
    "Allow Apple model requests": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
