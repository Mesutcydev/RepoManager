          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auszüge sind unvollständig. Der vollständige Verlauf bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los extractos son incompletos. Se conserva la conversación completa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıntılar eksiktir. Konuşmanın tamamı korunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقتطفات غير مكتملة. يتم الاحتفاظ بالمحادثة كاملة."
