          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanma bildirimleri açılamadı. Ayarlar’dan tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
