    "Reasoning adapts from catalog metadata and supported model families. Unrecognized models use answer-style guidance.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasoning adapts from catalog metadata and supported model families. Unrecognized models use answer-style guidance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Denken passt sich Katalogmetadaten und unterstützten Modellfamilien an. Unbekannte Modelle nutzen Antwortstilvorgaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El razonamiento se adapta a los metadatos del catálogo y familias compatibles. Los modelos no reconocidos usan orientación de estilo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكيف الاستدلال حسب بيانات الفهرس وعائلات النماذج المدعومة. تستخدم النماذج غير المعروفة إرشادات أسلوب الإجابة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıl yürütme katalog üst verilerine ve desteklenen model ailelerine uyarlanır. Tanınmayan modeller yanıt biçimi yönlendirmesi kullanır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推論はカタログのメタデータと対応モデル群に合わせて調整されます。認識されないモデルには回答スタイルの指針を使います。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तर्क कैटलॉग मेटाडेटा और समर्थित मॉडल परिवार के अनुसार ढलता है। अज्ञात मॉडल उत्तर-शैली के निर्देश इस्तेमाल करते हैं।"
          }
        }
      }
    },
