    "Eligible AI requests in Repo Manager use your ChatGPT plan. Manage this app's access and usage in ChatGPT settings.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible AI requests in Repo Manager use your ChatGPT plan. Manage this app's access and usage in ChatGPT settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigte KI-Anfragen in Repo Manager nutzen dein ChatGPT-Abo. Verwalte App-Zugriff und Nutzung in den ChatGPT-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de IA compatibles en Repo Manager usan tu plan de ChatGPT. Gestiona el acceso y el uso de la app en los ajustes de ChatGPT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم طلبات الذكاء الاصطناعي المؤهلة خطتك في ChatGPT. أدر وصول التطبيق واستخدامه في إعدادات ChatGPT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager’daki uygun yapay zekâ istekleri ChatGPT planını kullanır. Uygulama erişimini ve kullanımını ChatGPT ayarlarından yönet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Managerの対象AIリクエストではChatGPTプランを使用します。アプリのアクセス権と使用状況はChatGPTの設定で管理できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager में पात्र AI अनुरोध आपका ChatGPT प्लान इस्तेमाल करते हैं। ऐप ऐक्सेस और उपयोग ChatGPT सेटिंग में संभालें।"
          }
        }
      }
    },
    "Eligible ChatGPT Plus and Pro users can use their plan for AI requests in Repo Manager. You can review app access and usage in ChatGPT settings.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible ChatGPT Plus and Pro users can use their plan for AI requests in Repo Manager. You can review app access and usage in ChatGPT settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigte ChatGPT-Plus- und Pro-Nutzer können ihr Abo für KI-Anfragen in Repo Manager nutzen. App-Zugriff und Nutzung lassen sich in den ChatGPT-Einstellungen prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios de ChatGPT Plus y Pro elegibles pueden usar su plan para solicitudes de IA en Repo Manager. Puedes revisar el acceso y el uso en los ajustes de ChatGPT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمستخدمي ChatGPT Plus وPro المؤهلين استخدام خطتهم لطلبات الذكاء الاصطناعي في Repo Manager. راجع وصول التطبيق واستخدامه في إعدادات ChatGPT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygun ChatGPT Plus ve Pro kullanıcıları Repo Manager’da yapay zekâ istekleri için planlarını kullanabilir. Uygulama erişimini ve kullanımını ChatGPT ayarlarından inceleyebilirsin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のChatGPT Plus・Proユーザーは、Repo ManagerのAIリクエストにプランを利用できます。アプリのアクセス権と使用状況はChatGPTの設定で確認できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्र ChatGPT Plus और Pro उपयोगकर्ता Repo Manager में AI अनुरोधों के लिए अपना प्लान इस्तेमाल कर सकते हैं। ऐप ऐक्सेस और उपयोग ChatGPT सेटिंग में देख सकते हैं।"
          }
        }
      }
    },
    "Empty prices remain unknown. Enter only verified prices for this exact model and destination.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty prices remain unknown. Enter only verified prices for this exact model and destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Preise bleiben unbekannt. Trage nur bestätigte Preise für genau dieses Modell und Ziel ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios vacíos quedan como desconocidos. Introduce solo precios verificados para este modelo y destino exactos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأسعار الفارغة مجهولة. أدخل أسعارًا موثقة لهذا النموذج والوجهة تحديدًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş fiyatlar bilinmiyor olarak kalır. Yalnızca bu model ve hedef için doğrulanmış fiyatları gir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の価格は不明のままです。このモデルと送信先に対して確認済みの価格のみ入力してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली कीमतें अज्ञात रहती हैं। केवल इसी मॉडल और गंतव्य की पुष्ट कीमतें डालें।"
          }
        }
      }
    },
