          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदाता जोड़कर बातचीत शुरू करें। फ़ाइलें देखने या बदलाव की योजना बनाने के लिए रिपॉज़िटरी जोड़ें।"
