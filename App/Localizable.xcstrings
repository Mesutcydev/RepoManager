    "Native device-owner authentication is required. Review visibility, permissions, protection and deployment effects before continuing.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native device-owner authentication is required. Review visibility, permissions, protection and deployment effects before continuing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Geräteauthentifizierung erforderlich. Prüfe Sichtbarkeit, Berechtigungen, Schutz und Deployment-Auswirkungen, bevor du fortfährst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere autenticación nativa del propietario. Revisa la visibilidad, los permisos, la protección y los efectos del despliegue antes de continuar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلزم مصادقة مالك الجهاز الأصلية. راجع الظهور والصلاحيات والحماية وتأثيرات النشر قبل المتابعة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel aygıt sahibi kimlik doğrulaması gerekir. Devam etmeden önce görünürlük, izinler, koruma ve dağıtım etkilerini incele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス所有者のネイティブ認証が必要です。続ける前に公開範囲、権限、保護、デプロイへの影響を確認してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस मालिक का नेटिव प्रमाणीकरण चाहिए। जारी रखने से पहले दृश्यता, अनुमतियाँ, सुरक्षा और डिप्लॉयमेंट प्रभाव देखें।"
          }
        }
      }
    },
