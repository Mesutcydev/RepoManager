    "Earlier context was compacted locally. The full conversation remains available; the next reply uses recent turns and bounded excerpts.": {
      "comment": "Session interface. Preserve the order and types of format placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier context was compacted locally. The full conversation remains available; the next reply uses recent turns and bounded excerpts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früherer Kontext wurde lokal komprimiert. Die gesamte Unterhaltung bleibt verfügbar; die nächste Antwort verwendet aktuelle Beiträge und begrenzte Auszüge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto anterior se compactó localmente. La conversación completa sigue disponible; la siguiente respuesta usa intercambios recientes y extractos limitados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bağlam yerel olarak sıkıştırıldı. Konuşmanın tamamı kullanılabilir; sonraki yanıt son konuşmaları ve sınırlı alıntıları kullanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختصار السياق السابق محليًا. تبقى المحادثة كاملة متاحة؛ يستخدم الرد التالي التبادلات الحديثة ومقتطفات محدودة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराना संदर्भ स्थानीय रूप से संक्षिप्त किया गया। पूरी बातचीत उपलब्ध है; अगला उत्तर हाल के संवाद और सीमित अंश उपयोग करेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のコンテキストをローカルで圧縮しました。会話全文は引き続き閲覧できます。次の応答には最近の会話と制限付きの抜粋を使用します。"
          }
        }
      }
    },
    "Notifications are disabled for Repo Manager. Enable them in Settings to receive completion alerts.": {
      "comment": "Session interface. Preserve the order and types of format placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled for Repo Manager. Enable them in Settings to receive completion alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Repo Manager sind deaktiviert. Aktiviere sie in den Einstellungen, um Abschlussmeldungen zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Repo Manager están desactivadas. Actívalas en Ajustes para recibir avisos de finalización."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager bildirimleri kapalı. Tamamlanma uyarıları almak için Ayarlar’dan açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات Repo Manager معطلة. فعّلها في الإعدادات لتلقي تنبيهات الاكتمال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Manager की सूचनाएँ बंद हैं। पूर्णता सूचनाएँ पाने के लिए सेटिंग्स में चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Repo Managerの通知が無効です。完了通知を受け取るには設定で有効にしてください。"
          }
        }
      }
    },
    "Could not enable completion notifications. Try again in Settings.": {
      "comment": "Session interface. Preserve the order and types of format placeholders.",
      "localizations": {
        "en": {
          "stringUnit": {
