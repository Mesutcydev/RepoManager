    "Permanently erase this app’s local encrypted workspace?": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently erase this app’s local encrypted workspace?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokalen verschlüsselten Arbeitsbereich dieser App dauerhaft löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar permanentemente el espacio local cifrado de esta app?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح مساحة العمل المحلية المشفرة نهائيًا؟"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın yerel şifreli çalışma alanı kalıcı olarak silinsin mi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの暗号化されたローカル作業環境を完全に消去しますか？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप का स्थानीय एन्क्रिप्ट किया गया कार्यक्षेत्र हमेशा के लिए मिटाएँ?"
          }
        }
      }
    },
    "Permanently remove this app's encrypted records and Keychain items?": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently remove this app's encrypted records and Keychain items?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Datensätze und Schlüsselbundobjekte dieser App dauerhaft entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar permanentemente los registros cifrados y elementos del Llavero de esta app?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة سجلات التطبيق المشفرة وعناصر سلسلة المفاتيح نهائيًا؟"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın şifreli kayıtları ve Anahtar Zinciri öğeleri kalıcı olarak silinsin mi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
