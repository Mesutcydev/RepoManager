    "Pro unlocks app features. Your provider bills API usage separately; no API credits or ChatGPT subscription are included.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro unlocks app features. Your provider bills API usage separately; no API credits or ChatGPT subscription are included."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro schaltet App-Funktionen frei. Dein Anbieter rechnet die API-Nutzung separat ab; API-Guthaben oder ChatGPT-Abos sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro desbloquea funciones de la app. El proveedor factura el uso de API aparte; no incluye créditos de API ni suscripción a ChatGPT."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Pro ميزات التطبيق. يحاسبك المزود على استخدام API بشكل منفصل؛ لا يشمل أرصدة API أو اشتراك ChatGPT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro uygulama özelliklerini açar. Sağlayıcın API kullanımını ayrıca ücretlendirir; API kredisi veya ChatGPT aboneliği dahil değildir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proはアプリの機能を有効にします。API利用料はプロバイダが別途請求します。APIクレジットやChatGPTのサブスクリプションは含まれません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ऐप की सुविधाएँ खोलता है। प्रदाता API उपयोग का अलग शुल्क लेता है; API क्रेडिट या ChatGPT सदस्यता शामिल नहीं है।"
          }
        }
      }
    },
