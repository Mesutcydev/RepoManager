          }
        }
      }
    },
    "Your mail app opens a report to %@ for you to review before sending. Credentials in the response are masked. %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mail app opens a report to %@ for you to review before sending. Credentials in the response are masked. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mail-App öffnet einen Bericht an %@, den du vor dem Senden prüfen kannst. Zugangsdaten in der Antwort werden maskiert. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu app de correo abre un informe para %@ que puedes revisar antes de enviarlo. Se ocultan las credenciales de la respuesta. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تطبيق بريدك بلاغًا إلى %@ لمراجعته قبل الإرسال. تُحجب بيانات الاعتماد في الرد. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta uygulaman göndermeden önce incelemen için %@ adresine bir bildirim açar. Yanıttaki kimlik bilgileri maskelenir. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアプリで%@宛の報告を開き、送信前に確認できます。回答内の認証情報はマスクします。%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेल ऐप %@ के लिए रिपोर्ट खोलता है, जिसे भेजने से पहले आप जाँच सकते हैं। जवाब के क्रेडेंशियल छिपाए जाते हैं। %@"
          }
        }
      }
    },
