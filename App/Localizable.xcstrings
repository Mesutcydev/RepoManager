    "A locked or missing Keychain key never replaces your encrypted records.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A locked or missing Keychain key never replaces your encrypted records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gesperrter oder fehlender Schlüsselbundschlüssel ersetzt niemals deine verschlüsselten Datensätze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave del Llavero bloqueada o ausente nunca reemplaza tus registros cifrados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يؤدي قفل مفتاح سلسلة المفاتيح أو فقدانه إلى استبدال سجلاتك المشفرة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli veya eksik bir Anahtar Zinciri anahtarı, şifreli kayıtlarının yerini asla almaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンのキーがロック中または見つからなくても、暗号化済みの記録は置き換えられません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन कुंजी लॉक होने या न मिलने पर भी आपके एन्क्रिप्ट किए गए रिकॉर्ड कभी बदले नहीं जाते।"
          }
        }
      }
    },
    "A native workspace for your GitHub repositories. Read, discuss, and shape your next change in one place.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A native workspace for your GitHub repositories. Read, discuss, and shape your next change in one place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nativer Arbeitsbereich für deine GitHub-Repositories. Lies, besprich und gestalte deine nächste Änderung an einem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio nativo para tus repositorios de GitHub. Lee, conversa y prepara tu próximo cambio en un solo lugar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة عمل أصلية لمستودعات GitHub. اقرأ وناقش وصغ تغييرك التالي في مكان واحد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub depoların için yerel bir çalışma alanı. Bir sonraki değişikliğini tek bir yerde oku, tartış ve şekillendir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubリポジトリのためのネイティブな作業環境。コードの確認、相談、次の変更の準備を一か所で。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी GitHub रिपॉज़िटरी के लिए एक नेटिव कार्यक्षेत्र। एक ही जगह पढ़ें, चर्चा करें और अगला बदलाव तैयार करें।"
          }
        }
      }
    },
    "A thoughtful next step": {
      "extractionState": "manual",
      "generatesSymbol": false,
