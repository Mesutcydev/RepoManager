    "Uses the model prices captured when this response began and reported counts across all tool rounds. Discounts, cache pricing, and destination fees may differ.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the model prices captured when this response began and reported counts across all tool rounds. Discounts, cache pricing, and destination fees may differ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt die beim Antwortbeginn erfassten Modellpreise und gemeldeten Werte aller Werkzeugrunden. Rabatte, Cache-Preise und Zielgebühren können abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los precios capturados al comenzar la respuesta y los conteos de todas las rondas de herramientas. Descuentos, precios de caché y tarifas de destino pueden variar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم أسعار النموذج عند بدء الرد والأعداد المبلّغ عنها عبر كل جولات الأدوات. قد تختلف الخصومات وأسعار الذاكرة المؤقتة ورسوم الوجهة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt başladığında kaydedilen model fiyatlarını ve tüm araç turlarında bildirilen sayıları kullanır. İndirimler, önbellek fiyatları ve hedef ücretleri değişebilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答開始時のモデル価格と、すべてのツール処理で報告された使用量を使います。割引、キャッシュ料金、送信先の手数料は異なる場合があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब शुरू होते समय के मॉडल मूल्य और सभी टूल चरणों की बताई गिनती इस्तेमाल होती है। छूट, कैश कीमत और गंतव्य शुल्क अलग हो सकते हैं।"
          }
        }
      }
    },
    "Uses your eligible ChatGPT plan and its usage limits.": {
