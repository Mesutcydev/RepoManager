      }
    },
    "Use Apple Intelligence, a provider’s API key, or your own HTTPS endpoint. You approve where your conversations go.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Apple Intelligence, a provider’s API key, or your own HTTPS endpoint. You approve where your conversations go."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Apple Intelligence, den API-Schlüssel eines Anbieters oder deinen eigenen HTTPS-Endpunkt. Du genehmigst, wohin deine Chats gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Apple Intelligence, la clave API de un proveedor o tu endpoint HTTPS. Tú autorizas adónde van tus conversaciones."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Apple Intelligence أو مفتاح API لمزود أو نقطة HTTPS الخاصة بك. أنت توافق على وجهة محادثاتك."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, sağlayıcının API anahtarı veya kendi HTTPS uç noktanı kullan. Sohbetlerinin nereye gideceğini sen onaylarsın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence、プロバイダのAPIキー、自分のHTTPSエンドポイントを利用できます。会話の送信先は自分で承認します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, प्रदाता की API कुंजी या अपना HTTPS एंडपॉइंट इस्तेमाल करें। बातचीत कहाँ जाए, इसकी मंज़ूरी आप देते हैं।"
          }
        }
      }
    },
    "Use a token instead": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a token instead"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen Token verwenden"
