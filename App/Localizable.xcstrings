    "Allow tools to fetch public HTTPS pages from the exact hosts below. URLs in repository text cannot grant access to other hosts.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tools to fetch public HTTPS pages from the exact hosts below. URLs in repository text cannot grant access to other hosts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Werkzeugen, öffentliche HTTPS-Seiten von den unten genau angegebenen Hosts abzurufen. URLs im Repository-Text können keinen Zugriff auf andere Hosts gewähren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite obtener páginas HTTPS públicas de los hosts exactos indicados. Las URL del texto del repositorio no pueden dar acceso a otros hosts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للأدوات بجلب صفحات HTTPS العامة من المضيفين المحددين أدناه فقط. روابط نص المستودع لا تمنح الوصول لمضيفين آخرين."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçların aşağıdaki tam ana makinelerden herkese açık HTTPS sayfalarını almasına izin ver. Depo metnindeki URL’ler başka ana makinelere erişim veremez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下に指定したホストの公開HTTPSページをツールが取得することを許可します。リポジトリ内のURLから他のホストへのアクセスは許可されません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल को नीचे दिए सटीक होस्ट से सार्वजनिक HTTPS पेज लाने दें। रिपॉज़िटरी के पाठ में मौजूद URL दूसरे होस्ट की अनुमति नहीं दे सकते।"
          }
        }
      }
    },
