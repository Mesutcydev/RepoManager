    "Purchase approval is pending. Pro will unlock when the App Store confirms it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase approval is pending. Pro will unlock when the App Store confirms it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufgenehmigung steht aus. Pro wird freigeschaltet, sobald der App Store bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación de compra está pendiente. Pro se desbloqueará cuando lo confirme el App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة على الشراء معلقة. سيُفتح Pro عند تأكيد App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onayı bekleniyor. App Store onayladığında Pro açılacak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認待ちです。App Storeの確認後にProが有効になります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी की मंज़ूरी लंबित है। App Store की पुष्टि पर Pro अनलॉक होगा।"
          }
        }
      }
    },
