          "stringUnit": {
            "state": "translated",
            "value": "बिना क्वालिफ़ायर कीवर्ड से कोड खोजें। GitHub केवल डिफ़ॉल्ट ब्रांच इंडेक्स करता है।"
          }
        }
      }
    },
