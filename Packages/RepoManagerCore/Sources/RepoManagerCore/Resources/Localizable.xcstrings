    "The model allocates reasoning for this request using its provider defaults.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model allocates reasoning for this request using its provider defaults."
          }
        },
        "de": {
          "stringUnit": {
