      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT restricted this request for the selected account, workspace, or region."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT hat diese Anfrage für das gewählte Konto, den Arbeitsbereich oder die Region eingeschränkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT restringió esta solicitud para la cuenta, espacio o región seleccionados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيّد ChatGPT هذا الطلب للحساب أو مساحة العمل أو المنطقة المحددة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT bu isteği seçili hesap, çalışma alanı veya bölge için kısıtladı."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアカウント、ワークスペース、地域ではChatGPTがこのリクエストを制限しています。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT ने चुने खाते, कार्यक्षेत्र या क्षेत्र के लिए यह अनुरोध सीमित किया।"
          }
        }
      }
    },
    "ChatGPT sign-in expired. Start sign-in again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
