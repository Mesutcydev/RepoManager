    "Search this repository's code by keywords, without qualifiers. GitHub indexes only the default branch.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "comment": "Presentation of stable tool/schema metadata. Keep identifiers in code unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search this repository's code by keywords, without qualifiers. GitHub indexes only the default branch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository-Code per Stichwort ohne Qualifizierer durchsuchen. GitHub indexiert nur den Standardbranch."
          }
