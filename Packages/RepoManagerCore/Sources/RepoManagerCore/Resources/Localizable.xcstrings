        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحث شيفرة المستودع بكلمات دون محددات. يفهرس GitHub الفرع الافتراضي فقط."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
