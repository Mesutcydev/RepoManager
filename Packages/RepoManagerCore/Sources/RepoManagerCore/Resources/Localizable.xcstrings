      }
    },
    "The result is uncertain. Reconcile the remote state before retrying.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Reconcile the remote state before retrying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist unklar. Gleiche den entfernten Zustand ab, bevor du es erneut versuchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es incierto. Verifica el estado remoto antes de reintentar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتيجة غير مؤكدة. طابق الحالة البعيدة قبل إعادة المحاولة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç belirsiz. Yeniden denemeden önce uzak durumu uzlaştır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を確認できません。再試行する前にリモートの状態を照合してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम अनिश्चित है। फिर कोशिश करने से पहले रिमोट स्थिति का मिलान करें।"
          }
        }
      }
    },
    "The run reached its tool limit. Findings are limited to the available results; coverage may be incomplete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The run reached its tool limit. Findings are limited to the available results; coverage may be incomplete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lauf hat das Werkzeuglimit erreicht. Die Erkenntnisse beschränken sich auf die verfügbaren Ergebnisse; die Abdeckung kann unvollständig sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución alcanzó el límite de herramientas. Los hallazgos se limitan a los resultados disponibles; la cobertura puede ser incompleta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل التشغيل إلى حد استخدام الأدوات. تقتصر النتائج على المعلومات المتاحة؛ وقد تكون التغطية غير مكتملة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma, araç sınırına ulaştı. Bulgular mevcut sonuçlarla sınırlıdır; kapsam eksik olabilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの使用上限に達しました。調査結果は取得済みの情報に限られ、対象範囲が不完全な場合があります。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रन ने टूल की सीमा पूरी कर ली है। निष्कर्ष उपलब्ध परिणामों तक सीमित हैं; कवरेज अधूरी हो सकती है।"
          }
        }
      },
      "extractionState": "manual",
      "generatesSymbol": false
    },
    "The service rate limit was reached. Retry later.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
