          "stringUnit": {
            "state": "translated",
            "value": "إضافة خطاف ويب يرسل الأحداث المحددة لرابط HTTPS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili olayları HTTPS URL’sine gönderen web kancası ekle."
