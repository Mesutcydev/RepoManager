        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رمز تسجيل دخول GitHub. ابدأ مجددًا للحصول على رمز جديد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub giriş kodunun süresi doldu. Yeni kod almak için yeniden başlat."
