    "Add a comment to an issue or pull request by number.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "comment": "Presentation of stable tool/schema metadata. Keep identifiers in code unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a comment to an issue or pull request by number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Kommentar per Nummer zu einem Issue oder Pull Request hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un comentario a una incidencia o solicitud por número."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة تعليق لمشكلة أو طلب سحب حسب الرقم."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numarasıyla sorun veya çekme isteğine yorum ekle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を指定してIssueまたはPRにコメントを追加します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नंबर से समस्या या पुल अनुरोध में टिप्पणी जोड़ें।"
          }
        }
      }
    },
    "Add a webhook that posts selected events to an HTTPS URL.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "comment": "Presentation of stable tool/schema metadata. Keep identifiers in code unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a webhook that posts selected events to an HTTPS URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
