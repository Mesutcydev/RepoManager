    "ChatGPT could not authorize this request. Check the selected account and its plan permission.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT could not authorize this request. Check the selected account and its plan permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT konnte diese Anfrage nicht autorisieren. Prüfe das gewählte Konto und die Abo-Berechtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT no pudo autorizar la solicitud. Revisa la cuenta y su permiso de plan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
