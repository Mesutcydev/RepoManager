        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek üst öğeli commit için ileri geri alma hazırla; geçmişi yeniden yazmaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を書き換えず、親が1つのコミットを打ち消す新しいコミットを準備します。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पैरेंट कमिट का आगे वाला रिवर्ट तैयार करें; इतिहास न बदलें।"
          }
        }
      }
    },
