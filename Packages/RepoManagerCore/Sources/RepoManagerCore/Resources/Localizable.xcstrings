    "This request includes %lld of %lld permitted tools. Tool discovery adds relevant tools within the context budget. The complete catalog remains available in Tools.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request includes %lld of %lld permitted tools. Tool discovery adds relevant tools within the context budget. The complete catalog remains available in Tools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage enthält %lld von %lld erlaubten Werkzeugen. Die Werkzeugsuche ergänzt passende Werkzeuge innerhalb des Kontextbudgets. Der vollständige Katalog bleibt unter „Werkzeuge“ verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud incluye %lld de %lld herramientas permitidas. El descubrimiento añade las relevantes dentro del contexto. El catálogo completo sigue en Herramientas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن الطلب %lld من %lld أداة مسموحة. يضيف اكتشاف الأدوات الأدوات المناسبة ضمن ميزانية السياق. يبقى الفهرس الكامل في الأدوات."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek izinli araçların %lld / %lld kadarını içerir. Araç keşfi bağlam bütçesi içinde ilgili araçları ekler. Tam katalog Araçlar’da kalır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストには許可済みツールの%lld／%lld件が含まれます。ツール探索はコンテキスト上限内で関連ツールを追加します。全カタログは「ツール」で確認できます。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अनुरोध में %lld / %lld अनुमत टूल हैं। टूल खोज संदर्भ सीमा में संबंधित टूल जोड़ती है। पूरा कैटलॉग टूल में उपलब्ध है।"
          }
        }
      }
    },
    "This request uses a capability unavailable with your ChatGPT plan. Change the request before trying again.": {
