    "GitHub sign-in is temporarily unavailable. Use a fine-grained token or try again after the app is updated.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sign-in is temporarily unavailable. Use a fine-grained token or try again after the app is updated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GitHub-Anmeldung ist vorübergehend nicht verfügbar. Nutze ein fein abgestuftes Token oder versuche es nach einem App-Update erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de GitHub no está disponible temporalmente. Usa un token de acceso específico o reinténtalo tras actualizar la app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل دخول GitHub غير متاح مؤقتًا. استخدم رمز وصول دقيق الصلاحيات أو حاول بعد تحديث التطبيق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub girişi geçici olarak kullanılamıyor. Ayrıntılı izinli bir belirteç kullan veya uygulama güncellendikten sonra yeniden dene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubへのサインインは一時的に利用できません。きめ細かいアクセストークンを使うか、アプリの更新後に再試行してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub साइन-इन अभी उपलब्ध नहीं है। सीमित अनुमतियों वाला टोकन इस्तेमाल करें या ऐप अपडेट के बाद फिर कोशिश करें।"
          }
        }
      }
    },
    "GitHub sign-in is unavailable in this build. Update Repo Manager or use a fine-grained token.": {
