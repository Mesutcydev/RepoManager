    },
    "The output cap cannot fit the model's minimum thinking budget; keeping the provider default.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The output cap cannot fit the model's minimum thinking budget; keeping the provider default."
