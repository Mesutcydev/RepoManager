      }
    },
    "The model finished without a reply or tool call. Your draft is retained. Try again explicitly.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model finished without a reply or tool call. Your draft is retained. Try again explicitly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell endete ohne Antwort oder Werkzeugaufruf. Dein Entwurf bleibt erhalten. Versuche es ausdrücklich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo terminó sin respuesta ni llamada a herramientas. Se conserva el borrador. Vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى النموذج دون رد أو استدعاء أداة. حُفظت مسودتك. أعد المحاولة صراحةً."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yanıt veya araç çağrısı olmadan tamamlandı. Taslağın korundu. Yeniden dene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは回答もツール呼び出しも行わず終了しました。下書きは保持されています。再試行してください。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल बिना जवाब या टूल कॉल के समाप्त हुआ। ड्राफ़्ट सुरक्षित है। फिर कोशिश करें।"
          }
        }
      }
    },
    "The model reached the output cap, which includes reasoning tokens. Adjust reasoning or explicitly continue; no retry was sent.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model reached the output cap, which includes reasoning tokens. Adjust reasoning or explicitly continue; no retry was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell erreichte das Ausgabelimit einschließlich Denk-Tokens. Passe das Denken an oder fahre ausdrücklich fort; es wurde kein Neuversuch gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo alcanzó el límite de salida, incluidos tokens de razonamiento. Ajusta el razonamiento o continúa explícitamente; no se reintentó."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ النموذج حد الإخراج شاملاً رموز الاستدلال. عدّل الاستدلال أو تابع صراحةً؛ لم تُرسل إعادة محاولة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, akıl yürütme tokenleri dahil çıktı sınırına ulaştı. Akıl yürütmeyi ayarla veya açıkça devam et; yeniden deneme gönderilmedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推論トークンを含む出力上限に達しました。推論設定を調整するか、明示的に続けてください。再試行は送信していません。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तर्क टोकन सहित आउटपुट सीमा पर पहुँचा। तर्क बदलें या स्पष्ट रूप से जारी रखें; फिर कोशिश नहीं भेजी गई।"
          }
